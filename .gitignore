# Generated by notebook — large or binary files, not needed in source control
data/*
models/*
maps/*
images/*

# But keep the folder structure visible on GitHub
!data/.gitkeep
!models/.gitkeep
!maps/.gitkeep
!images/.gitkeep

# Raw dataset (100MB+ CSV)
*.csv

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual environments
env/
venv/
.venv/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.suo
*.user

# Secrets / env files
.env
*.env
